# Public client configuration. Publishable values only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_BASE_URL=

# Scene Intelligence v1 is opt-in until preview + real-device acceptance passes.
EXPO_PUBLIC_SCENE_INTELLIGENCE_V1=false
EXPO_PUBLIC_SCENE_DEPTH_DIAGNOSTICS=false

# Server-only. Never prefix with EXPO_PUBLIC_ or NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AI_GATEWAY_API_KEY=
FORMSHIFT_AI_MODEL=

# Private access bootstrap. Used only by an owner/admin provisioning path.
FORMSHIFT_ALLOWED_WEB_ORIGINS=
